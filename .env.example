# ClickHouse connection. Works with local (brew/docker) and ClickHouse Cloud.
# For ClickHouse Cloud use https://<host>:8443 and set the password.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=fourier

# Public URL of this dashboard/ingest server, used in the install snippet.
NEXT_PUBLIC_FOURIER_HOST=http://localhost:5050

# ---- Accounts and sessions ----
# All optional. `pnpm dev` needs none of them: authentication is off in
# development, and a deployed instance asks you to create the first account
# the first time it is opened.

# Signs session cookies and hashes read keys. Generated and stored on first
# boot when unset. Set it explicitly in production: changing it signs everyone
# out, which is how you revoke every session at once.
# FOURIER_SECRET=

# Require sign-in while running `next dev`, to test the real flow locally.
# FOURIER_REQUIRE_AUTH=true

# Require this token on the create-first-account screen. Worth setting if the
# deployment is reachable publicly before you have claimed it.
# FOURIER_SETUP_TOKEN=

# Origins allowed to call the API with cookies, comma separated. Only needed
# when the dashboard is deployed separately from the server.
# FOURIER_ALLOWED_ORIGINS=https://analytics.example.com

# Point a separately-deployed dashboard at its server. Leave unset when the
# dashboard and API share an origin, which is the default.
# NEXT_PUBLIC_FOURIER_API_URL=

# ---- Location ----
# Only needed when nothing in front of this server resolves the visitor's country
# already. Vercel, Cloudflare and CloudFront all do, and are read automatically.
#
# Path to a MaxMind-format .mmdb file, read once at startup. DB-IP Lite works and
# needs no account: https://db-ip.com/db/lite.php
# Unset, events simply carry no location.
# FOURIER_GEOIP_DB=/var/lib/fourier/dbip-city-lite.mmdb
