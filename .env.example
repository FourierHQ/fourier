# ClickHouse connection. Works with local (brew/docker) and ClickHouse Cloud.
# For ClickHouse Cloud use https://<host>:8443 and set the password.
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=fourier

# Public URL of this dashboard/ingest server, used in the install snippet.
NEXT_PUBLIC_FOURIER_HOST=http://localhost:5050
