{
  "name": "fourier-monorepo",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm --filter @fourierhq/web dev",
    "dev:demo": "pnpm --filter @fourierhq/example-nextjs dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @fourierhq/sdk test",
    "typecheck": "pnpm -r typecheck",
    "clickhouse": "clickhouse server --config-file=./infra/clickhouse/config.xml",
    "seed": "pnpm --filter @fourierhq/web seed",
    "mcp": "pnpm --filter @fourierhq/web mcp"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FourierHQ/fourier.git"
  },
  "homepage": "https://github.com/FourierHQ/fourier"
}
