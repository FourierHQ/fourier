{
  "name": "fourier",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Open source product analytics SDK. identify/track/page, analytics.js-shaped, with first-class Next.js support.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "next": ">=13",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FourierHQ/fourier.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/FourierHQ/fourier",
  "keywords": [
    "analytics",
    "product-analytics",
    "segment",
    "analytics.js",
    "amplitude",
    "clickhouse",
    "nextjs"
  ]
}
