<!-- Minimal single-node ClickHouse config for local development.
     Data lives in ./.clickhouse (gitignored). Start with `pnpm clickhouse`. -->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <listen_host>127.0.0.1</listen_host>
    <path>./.clickhouse/data/</path>
    <tmp_path>./.clickhouse/tmp/</tmp_path>
    <user_files_path>./.clickhouse/user_files/</user_files_path>
    <format_schema_path>./.clickhouse/format_schemas/</format_schema_path>
    <mark_cache_size>268435456</mark_cache_size>
    <max_server_memory_usage_to_ram_ratio>0.5</max_server_memory_usage_to_ram_ratio>
    <user_directories>
        <users_xml>
            <path>./infra/clickhouse/users.xml</path>
        </users_xml>
    </user_directories>
</clickhouse>
